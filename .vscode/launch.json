{
    "configurations": [
    {
        "name": "(gdb) Launch",
        "type": "cppdbg",
        "request": "launch",
        "program": "/home/oster/Mashroom/build/Debug/bin/Mashroom_data_exchange_test",
        "args": ["launch"],
        "stopAtEntry": true,
        "cwd": "${cwd}",
        "externalConsole": false,
        "MIMode": "gdb",
        "miDebuggerPath": "/home/oster/binutils-gdb/install/bin/gdb",
        "environment": [
            {
                "name": "LD_LIBRARY_PATH",
                "value": "LD_LIBRARY_PATH"
            }
        ],
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    },
    {
        "name": "Launch",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "args": ["--src=/home/oster/Mashroom/external/eccodes/definitions/grib1",
                 "--out=/home/oster/Mashroom/grib1/include/generated/code_tables"],
        "cwd": "${cwd}",
        "console": "internalConsole",
        "env": {}
    },
    {
        "name": "Build",
        "type": "cmake",
        "request": "launch",
        "scriptPath": "~/Mashroom/CMakeLists.txt",
        "cmakeDebugType": "script",
        "clean": false,
        "configureAll": true
    }
    ]
}

