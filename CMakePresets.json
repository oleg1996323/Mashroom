{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "include": ["CMakeUserPresets.json"],
    "configurePresets": [
        {
            "name": "default-debug",
            "inherits": ["conan-debug"],
            "displayName": "Configuration-Debug",
            "$comment": "Configuration for basic building and installing by Ninja in Unix systems",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "$env{HOME}/gcc/gcc-install/bin/g++",
                "CMAKE_C_COMPILER": "$env{HOME}/gcc/gcc-install/bin/gcc",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "OSTERLIB_PATH": "$env{HOME}/OsterLib-install",
                "CMAKE_INSTALL_PREFIX": "$env{HOME}/Mashroom-install"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "displayName": "default",
            "inherits":["conan-debug"]
        },
        {
            "name": "default-debug",
            "description": "default Build-Debug",
            "displayName": "Build-Debug(default)",
            "configurePreset": "default-debug",
            "inherits": ["default"]
        }
    ]
}