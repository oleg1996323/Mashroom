{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Configuration-Debug",
            "description": "Ninja configuration",
            "binaryDir": "${sourceDir}/build",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Debug",
                "CMAKE_CXX_COMPILER":"$env{HOME}/gcc/gcc-install/bin/g++",
                "CMAKE_C_COMPILER":"$env{HOME}/gcc/gcc-install/bin/gcc",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "OSTERLIB_PATH":"$env{HOME}/OsterLib-install"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "displayName": "Build-Debug",
            "configurePreset": "default",
            "jobs": 12
        }
    ]
}